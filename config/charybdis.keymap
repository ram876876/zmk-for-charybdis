#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };

        mouse_sensivity: mouse_sensivity {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release>, <&mmv MOVE_X(0) &mmv MOVE_Y(0)>;

            label = "MOUSE_SENSIVITY";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp MINUS         &kp N1  &kp N2   &kp N3       &kp N4                &kp N5              &kp N6              &kp N7                &kp N8     &kp N9   &kp N0    &kp EQUAL
&kp GRAVE         &kp Q   &kp W    &kp E        &kp R                 &kp T               &kp Y               &kp U                 &kp I      &kp O    &kp P     &kp BACKSPACE
&kp TAB           &kp A   &lt 4 S  &kp D        &lt 3 F               &kp G               &kp H               &kp J                 &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_BRACKET  &kp Z   &kp X    &kp C        &kp V                 &kp B               &kp N               &kp M                 &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_BRACKET
                                   &lt 1 ENTER  &mt LEFT_SHIFT SPACE  &kp LEFT_CONTROL    &lt 2 LS(LEFT_ALT)  &mt LEFT_SHIFT SPACE
                                                &mt LEFT_ALT ESCAPE   &kp DEL             &kp LEFT_WIN
            >;
        };

        F_layers {
            bindings = <
&kp F1  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6     &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &none   &none   &none   &none   &trans                  &none      &none   &none   &none   &none    &none
&trans  &none   &none   &none   &none   &kp NON_US_BACKSLASH    &kp SLASH  &none   &none   &none   &none    &trans
&trans  &trans  &trans  &trans  &trans  &none                   &none      &none   &trans  &trans  &none    &none
                        &trans  &trans  &To0_macro              &none      &none
                                &trans  &trans                  &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &none   &none   &none   &none   &none        &trans     &trans          &trans               &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans     &trans          &kp UP_ARROW         &trans     &trans  &trans
&trans  &none   &trans  &trans  &trans  &mkp LCLK    &mkp RCLK  &kp LEFT_ARROW  &kp DOWN             &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &none   &trans  &trans       &none      &trans          &kp LS(PRINTSCREEN)  &trans     &trans  &trans
                        &trans  &trans  &trans       &trans     &trans
                                &trans  &trans       &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &none   &none   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &none   &none
                                &trans  &trans    &trans
            >;
        };
    };
};
